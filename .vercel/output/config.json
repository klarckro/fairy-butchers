{
  "version": 3,
  "overrides": {
    "index.html": {
      "path": ""
    }
  },
  "routes": [
    {
      "headers": {
        "cache-control": "public, max-age=31536000, immutable"
      },
      "src": "/_nuxt/builds/meta/(.*)"
    },
    {
      "headers": {
        "cache-control": "public, max-age=1, immutable"
      },
      "src": "/_nuxt/builds/(.*)"
    },
    {
      "headers": {
        "cache-control": "public, max-age=31536000, immutable"
      },
      "src": "/_nuxt/(.*)"
    },
    {
      "src": "/_nuxt/builds/meta(.*)",
      "headers": {
        "cache-control": "public,max-age=31536000,immutable"
      },
      "continue": true
    },
    {
      "src": "/_nuxt/builds(.*)",
      "headers": {
        "cache-control": "public,max-age=31536000,immutable"
      },
      "continue": true
    },
    {
      "src": "/_nuxt(.*)",
      "headers": {
        "cache-control": "public,max-age=31536000,immutable"
      },
      "continue": true
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "(?<__isr_route>/__nuxt_error)",
      "dest": "/__fallback"
    },
    {
      "src": "(?<__isr_route>/__nuxt_content/(?:.*))",
      "dest": "/__fallback"
    },
    {
      "src": "/__nuxt_error",
      "dest": "/__nuxt_error"
    },
    {
      "src": "/__nuxt_content/sponsors/query",
      "dest": "/__nuxt_content/sponsors/query"
    },
    {
      "src": "/__nuxt_content/site/query",
      "dest": "/__nuxt_content/site/query"
    },
    {
      "src": "/__nuxt_content/music/query",
      "dest": "/__nuxt_content/music/query"
    },
    {
      "src": "/__nuxt_content/members/query",
      "dest": "/__nuxt_content/members/query"
    },
    {
      "src": "/__nuxt_content/info/sql_dump.txt",
      "dest": "/__nuxt_content/info/sql_dump.txt"
    },
    {
      "src": "/__nuxt_content/info/query",
      "dest": "/__nuxt_content/info/query"
    },
    {
      "src": "/__nuxt_content/events/query",
      "dest": "/__nuxt_content/events/query"
    },
    {
      "src": "/__nuxt_island/(?:.*)",
      "dest": "/__nuxt_island/[...]"
    },
    {
      "src": "/(.*)",
      "dest": "/__fallback"
    }
  ]
}